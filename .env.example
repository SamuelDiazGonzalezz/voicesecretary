# Clave privada del servidor. Nunca uses el prefijo VITE_ para esta variable.
ELEVENLABS_API_KEY=

# Opcional: limita el catálogo público a estos IDs separados por comas.
ELEVENLABS_VOICE_IDS=
ELEVENLABS_VOICE_LIMIT=8
ELEVENLABS_MODEL_ID=eleven_v3

# En producción, la generación dinámica permanece apagada salvo activación explícita.
ELEVENLABS_DEMO_API_ENABLED=false

# ID de un agente público configurado en ElevenLabs.
VITE_ELEVENLABS_AGENT_ID=

# Opcional, por ejemplo: eu-residency
VITE_ELEVENLABS_SERVER_LOCATION=

# Endpoint HTTPS que recibe las solicitudes del formulario como JSON.
VITE_DEMO_ENDPOINT=
